# Sao chép thành .env rồi điền các giá trị. Không đưa .env vào Git/ZIP chia sẻ.
PORT=3000
APP_SECRET=replace-with-a-long-random-string

# Gmail SMTP: tài khoản Google bật xác minh 2 bước và tạo App Password.
GMAIL_USER=your-address@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password

# VNPay sandbox. Nhận mã website và khóa bí mật từ cổng merchant VNPay.
VNP_TMN_CODE=
VNP_HASH_SECRET=
VNP_PAYMENT_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# URL công khai của backend, để VNPay gọi return và IPN.
# localhost không nhận IPN từ Internet; dùng HTTPS URL khi kiểm thử VNPay.
PUBLIC_BASE_URL=http://localhost:3000
